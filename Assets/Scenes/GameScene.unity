  m_OnCullStateChanged:
    m_PersistentCalls:
      m_Calls: []
  m_text: "The city has fallen. The streets are overrun and most communication has
    been lost.\n\nYou've heard that a city to the east may still be safe, but the
    route there is blocked.\n\nScattered throughout the city are supplies and information
    left behind by those who came before you. Some of it may be outdated or wrong.\n\nFind
    what you need, learn the city, and find a way to the safe zone.\n\nWASD \u2014
    Move\nMouse \u2014 Aim\nLeft Click \u2014 Shoot\nR \u2014 Reload\nN \u2014 Notebook\nESC
    \u2014 Pause\n\nGood luck."
  m_isRightToLeft: 0
  m_fontAsset: {fileID: 11400000, guid: 8f586378b4e144a9851e7b34d9b748ee, type: 2}
